{
  "algorithm": "SplitFed",
  "model": "resnet18",
  "dataset": "cifar10",
  "device": "gpu",
  "launch_backend": "Local MPI",
  "docker_server_cpus": "1.0",
  "docker_server_memory": "2g",
  "docker_client_cpus": "1.0",
  "docker_client_memory": "2g",
  "docker_shm_size": "1g",
  "partition": "iid",
  "partition_alpha": "",
  "clients": 5,
  "epochs": 2,
  "batch_size": 128,
  "split_layer": 1,
  "lr": "0.01",
  "seed": 0,
  "comm_reduction": "codeword / uniform",
  "comm_direction": "forward_backward",
  "quantization_bits": "8bit",
  "sparsity_k": "5%",
  "dimensionality_reduction_ratio": "25%",
  "quantization_granularity": "per_tensor",
  "forward_quantization": "uniform",
  "backward_quantization": "uniform",
  "forward_quantization_addon": "none",
  "backward_quantization_addon": "none"
}